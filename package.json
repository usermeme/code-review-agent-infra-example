{
  "name": "code-review-agent-infra-example",
  "version": "1.0.0",
  "description": "Example GitOps Pulumi infrastructure for Code Review Agent on Google Cloud",
  "main": "index.ts",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "pulumi preview",
    "up": "pulumi up",
    "destroy": "pulumi destroy",
    "login:gcs": "pulumi login gs://<your-gcp-project-id>-pulumi-state",
    "prepare": "lefthook install",
    "setup:wif": "./scripts/setup-wif.sh",
    "test:webhook": "./scripts/test-webhook.sh"
  },
  "dependencies": {
    "@pulumi/gcp": "^8.18.0",
    "@pulumi/pulumi": "^3.150.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.0",
    "eslint": "^10.12.0",
    "lefthook": "^2.1.16",
    "prettier": "^3.9.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0"
  }
}
